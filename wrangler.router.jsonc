{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anzdrop-router",
  "main": "./workers/router/index.ts",
  "compatibility_date": "2026-09-17",
  "services": [
    { "binding": "HOME", "service": "anzdrop-home" },
    { "binding": "APP", "service": "anzdrop" }
  ],
  "routes": [
    {
      "pattern": "anzdrop.com/*",
      "zone_name": "anzdrop.com"
    }
  ]
}
