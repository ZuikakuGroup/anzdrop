// Local Hono development and dry-run only. Production uses wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "dev": { "ip": "127.0.0.1", "port": 8788 },
  "name": "anzdrop",
  "main": "./server/worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-05-03",
  "account_id": "2a1ab8b6a9b36f7f0c4292dce044e0c4",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "LOCAL_DEVELOPMENT": "true",
    "MICROCMS_SERVICE_DOMAIN": "anzdrop.microcms.io",
    "SITE_URL": "https://anzdrop.com",
    "CF_ACCESS_TEAM_DOMAIN": "dawn-union-04c8.cloudflareaccess.com",
    "CF_ACCESS_AUD": "ad07f142d7df7dd4fc8e6bf43afa688083a2c1dd42b725af3763d97b5d4c7f88",
    "STRIPE_PRICE_ID_STANDARD": "price_1U912gRoVdcNVq9tWSz1luJb",
    "STRIPE_PRICE_ID_PREMIUM": "price_1U912iRoVdcNVq9tfIzXTacc",
    "OPENNODE_BTC_CHARGE_AMOUNT_USD_STANDARD": 2,
    "OPENNODE_BTC_CHARGE_AMOUNT_USD_PREMIUM": 3,
    "OPENNODE_BTC_DAYS_PER_CHARGE": 30
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anzdrop-db",
      "database_id": "ad69638b-dbf8-4b71-beb2-0fc23d98d9cd"
    }
  ],
  "ratelimits": [
    {
      "name": "FILE_RATE_LIMITER",
      "namespace_id": "81001",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    },
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "81002",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "81003",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    },
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "81004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "81005",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "anzdrop"
    }
  ]
}
