{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anzdrop",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-05-03",
  "account_id": "2a1ab8b6a9b36f7f0c4292dce044e0c4",

  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "dawn-union-04c8.cloudflareaccess.com",
    "CF_ACCESS_AUD": "fec50a6e02744c407c8338a6696ef63c5786ed4fe976c2462948908c02103853"
  },

  "triggers": {
    "crons": ["0 0 * * *"]
  },

  "assets": {
    "directory": ".open-next/assets"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anzdrop-db",
      "database_id": "ad69638b-dbf8-4b71-beb2-0fc23d98d9cd"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "anzdrop"
    }
  ]
}