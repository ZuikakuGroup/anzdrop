---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogCards from '../../components/BlogCards.astro';
import { blog, isMicrocmsNotFoundError } from '../../lib/blog';
import { formatDate } from '@/lib/blog/site';
import { sanitizeArticleHtml } from '@/lib/blog/sanitize';
import ArticleImageLightbox from '@/app/blog/[slug]/ArticleImageLightbox';
import styles from '@/app/blog/[slug]/article-content.module.css';
let post;
try { post = await blog.getPost(Astro.params.slug!); }
catch (error) { if (isMicrocmsNotFoundError(error)) return Astro.rewrite('/404'); throw error; }
const related = await blog.getPosts({ filters: `category[equals]${post.category.id}[and]id[not_equals]${post.id}`, limit: 3 });
const path = `/blog/${encodeURIComponent(post.id)}`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: post.title, description: post.excerpt, datePublished: post.publishedAt, dateModified: post.updatedAt, image: post.eyecatch.url, author: { '@type': 'Person', name: post.author.name, url: new URL(`/blog/authors/${encodeURIComponent(post.author.id)}`, Astro.site).href }, mainEntityOfPage: new URL(path, Astro.site).href };
---
<BlogLayout title={`${post.title} | Anzdropブログ`} description={post.excerpt} canonical={path} image={post.eyecatch.url} article={post}>
  <ArticleImageLightbox client:load>
    <article class="mx-auto max-w-3xl space-y-8">
      <header class="space-y-4">
        <a href={`/blog/categories/${encodeURIComponent(post.category.id)}`} class="text-xs font-bold text-brand">{post.category.name}</a>
        <h1 class="text-3xl font-black leading-tight sm:text-4xl">{post.title}</h1>
        <p class="text-sm text-ink/60">公開日: {formatDate(post.publishedAt)}{post.updatedAt !== post.publishedAt ? ` / 更新日: ${formatDate(post.updatedAt)}` : ''}</p>
        <button type="button" data-zoomable-trigger aria-label="アイキャッチ画像を拡大表示" class="block w-full cursor-zoom-in rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"><img src={post.eyecatch.url} alt={post.eyecatch.alt ?? post.title} width={post.eyecatch.width ?? 1200} height={post.eyecatch.height ?? 630} fetchpriority="high" class="w-full rounded-lg object-cover" data-zoomable-image /></button>
      </header>
      <div class={styles.content} set:html={sanitizeArticleHtml(post.body)} />
      <footer class="space-y-4 border-t border-ink/10 pt-6">
        <div class="flex flex-wrap gap-2">{post.tags.map(tag => <a href={`/blog/tags/${encodeURIComponent(tag.id)}`} class="rounded bg-ink/[0.06] px-2.5 py-1 text-xs text-ink/70">#{tag.name}</a>)}</div>
        <a href={`/blog/authors/${encodeURIComponent(post.author.id)}`} class="flex items-center gap-3 rounded-lg border border-ink/10 p-4 hover:bg-ink/[0.03]"><img src={post.author.image.url} alt="" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-full object-cover" /><span><span class="block text-xs text-ink/50">著者</span><span class="font-bold">{post.author.name}</span></span></a>
      </footer>
    </article>
  </ArticleImageLightbox>
  {related.contents.length > 0 && <section class="mx-auto mt-14 max-w-6xl space-y-5"><h2 class="text-xl font-black">関連記事</h2><BlogCards posts={related.contents} /></section>}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</BlogLayout>
