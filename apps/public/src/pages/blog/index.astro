---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogCards from '../../components/BlogCards.astro';
import BlogPagination from '../../components/BlogPagination.astro';
import { blog, PAGE_SIZE } from '../../lib/blog';
import { parseBlogPage } from '@/lib/blog/pagination';
const values = Astro.url.searchParams.getAll('page');
const page = parseBlogPage(values.length === 1 ? values[0] : undefined);
const posts = await blog.getPosts({ limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE });
const lastPage = Math.max(1, Math.ceil(posts.totalCount / PAGE_SIZE));
if (page > lastPage) return Astro.redirect(lastPage === 1 ? '/blog' : `/blog?page=${lastPage}`);
---
<BlogLayout title="ブログ | Anzdrop" description="Anzdropのファイル共有、プライバシー、セキュリティに関するブログです." canonical="/blog">
  <div class="mx-auto max-w-6xl space-y-8">
    <header class="space-y-2"><p class="text-xs font-bold tracking-widest text-brand">BLOG</p><h1 class="text-3xl font-black">Anzdropブログ</h1><p class="text-sm text-ink/60">ファイル共有とプライバシーを、もっと身近に。</p></header>
    {posts.contents.length ? <BlogCards posts={posts.contents} /> : <p class="text-sm text-ink/60">公開中の記事はまだありません。</p>}
    {lastPage > 1 && <BlogPagination page={page} lastPage={lastPage} />}
  </div>
</BlogLayout>
