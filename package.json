{
  "name": "anzdrop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-app.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:router": "tsc --project workers/router/tsconfig.json --noEmit",
    "measure:home": "node scripts/measure-home.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:web": "npm run audit:seo && npm run audit:lighthouse",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "opennextjs-cloudflare build && node scripts/strip-vercel-og.mts && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/strip-vercel-og.mts && opennextjs-cloudflare deploy --var DEPLOYMENT_ENV:production",
    "deploy:home": "cd apps/home && ../../node_modules/.bin/opennextjs-cloudflare build --config wrangler.jsonc && node ../../scripts/strip-vercel-og.mts && ../../node_modules/.bin/opennextjs-cloudflare deploy --config wrangler.jsonc --var DEPLOYMENT_ENV:production",
    "deploy:router": "wrangler deploy --config wrangler.router.jsonc",
    "dev:public": "node --env-file-if-exists=.env.local scripts/run-public.mjs dev",
    "build:public": "node --env-file-if-exists=.env.local scripts/run-public.mjs build",
    "check:public": "node --env-file-if-exists=.env.local scripts/run-public.mjs check",
    "test:public": "bash scripts/test-public-astro.sh",
    "dev:api": "wrangler dev --config wrangler.api.jsonc --ip 127.0.0.1 --port 8788 --inspector-port 9230 --var ACCOUNT_AUTH_LOCAL_ORIGIN:http://localhost:3000",
    "dev:app": "npm run dev:public -- --host localhost --port 3000",
    "build:api": "wrangler deploy --config wrangler.api.jsonc --dry-run --outdir tmp/hono-build",
    "test:astro-hono": "bash scripts/test-astro-hono.sh",
    "dev:legacy": "next dev --webpack --hostname 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@hibiki-js/core": "^0.2.0",
    "@hibiki-js/stripe": "^0.3.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "aws4fetch": "^1.0.20",
    "chart.js": "^4.5.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "hash-wasm": "^4.12.0",
    "jsdom": "^30.1.2",
    "miniflare": "^4.20260730.0",
    "open-next": "^3.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.147.0"
  }
}
