{
  "name": "anzdrop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-app.mjs",
    "build": "npm run build:public && npm run build:api && npm run build:router",
    "start": "node scripts/preview-app.mjs",
    "lint": "eslint",
    "check:router": "tsc --project workers/router/tsconfig.json --noEmit",
    "benchmark:transfer": "TRANSFER_BENCH=1 E2E_TEST_FILES=tests/e2e/file-sharing.spec.ts E2E_WORKERS=1 npm run test:astro-hono -- --grep @transfer-benchmark",
    "benchmark:packet": "node --expose-gc scripts/benchmark-packet.mjs",
    "benchmark:upload-body": "node --expose-gc scripts/benchmark-upload-body.mjs",
    "measure:home": "node scripts/measure-home.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:web": "npm run audit:seo && npm run audit:lighthouse",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sharing": "E2E_TEST_FILES=tests/e2e/file-sharing.spec.ts E2E_WORKERS=1 npm run test:astro-hono --",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "node scripts/preview-app.mjs",
    "deploy": "bash scripts/prepare-auditable-deployment.sh && node scripts/deploy-audited.mjs",
    "deploy:router": "wrangler deploy --config wrangler.router.jsonc",
    "dev:public": "node --env-file-if-exists=.env.local scripts/run-public.mjs dev",
    "build:public": "node --env-file-if-exists=.env.local scripts/run-public.mjs build",
    "check:public": "node --env-file-if-exists=.env.local scripts/run-public.mjs check",
    "test:public": "bash scripts/test-public-astro.sh",
    "dev:api": "node --env-file-if-exists=.env.local scripts/dev-api.mjs",
    "dev:app": "npm run dev:public -- --host localhost --port 3000",
    "build:api": "wrangler deploy --config wrangler.jsonc --dry-run --outdir tmp/hono-build",
    "test:astro-hono": "bash scripts/test-astro-hono.sh",
    "build:router": "wrangler deploy --config wrangler.router.jsonc --dry-run --outdir tmp/router-build",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@hibiki-js/core": "^0.2.0",
    "@hibiki-js/stripe": "^0.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "aws4fetch": "^1.0.20",
    "chart.js": "^4.6.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.18",
    "jose": "^6.2.18",
    "nanoid": "^6.0.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hash-wasm": "^4.13.0",
    "jsdom": "^31.0.1",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.163.0"
  }
}
