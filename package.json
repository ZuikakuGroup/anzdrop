{
  "name": "anzdrop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:router": "tsc --project workers/router/tsconfig.json --noEmit",
    "measure:home": "node scripts/measure-home.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "opennextjs-cloudflare build && node scripts/strip-vercel-og.mts && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/strip-vercel-og.mts && opennextjs-cloudflare deploy --var DEPLOYMENT_ENV:production",
    "deploy:home": "cd apps/home && ../../node_modules/.bin/opennextjs-cloudflare build --config wrangler.jsonc && node ../../scripts/strip-vercel-og.mts && ../../node_modules/.bin/opennextjs-cloudflare deploy --config wrangler.jsonc --var DEPLOYMENT_ENV:production",
    "deploy:router": "wrangler deploy --config wrangler.router.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@hibiki-js/core": "^0.2.0",
    "@hibiki-js/stripe": "^0.2.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "chart.js": "^4.5.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "hash-wasm": "^4.12.0",
    "jsdom": "^30.1.0",
    "miniflare": "^4.20260730.0",
    "open-next": "^3.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
